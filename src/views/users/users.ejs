<%- include('../partials/header.ejs', {
    title : "Community Users",
    is_display_buttons : true,
    script : "", 
    stylesheet_html: '<link rel="stylesheet" href="/css-styles/style.css">'
}) %>

<div class="container mt-4">
    <h1>Community Users</h1>

    <!--------------------------------------FILTERS-------------------------------------------->
    <div class="card p-3 mb-4 bg-light">
        <form action="/users" method="GET" class="row g-3 align-items-end">
            
            <!---------------------------SEARCH BAR------------------------------------>
            <div class="col-md-4">
                <label class="form-label">Search a user :</label>
                <input type="text" name="search" class="form-control" value="<%= filters.search %>" placeholder="Username...">
            </div>

            <!---------------------------GAMES LIST------------------------------------>
            <div class="col-md-3">
                <label class="form-label">Game :</label>
                <select name="game" class="form-select">
                    <option value="all" <%= filters.game === 'all' ? 'selected' : '' %>>All Games</option>
                    <% games.forEach(game => { %>
                        <option value="<%= game.id %>" <%= filters.game === game.id ? 'selected' : '' %>><%= game.name %></option>
                    <% }); %>
                </select>
            </div>

            <!---------------------------STATUS------------------------------------>
            <div class="col-md-3">
                <label class="form-label">Status :</label>
                <select name="status" class="form-select">
                    <option value="all" <%= filters.status === 'all' ? 'selected' : '' %>>All Status</option>
                    <option value="connected" <%= filters.status === 'connected' ? 'selected' : '' %>>All Connected</option>
                    <option value="online" <%= filters.status === 'online' ? 'selected' : '' %>>🟢 Online</option>
                    <option value="busy" <%= filters.status === 'busy' ? 'selected' : '' %>>🔴 Busy</option>
                    <option value="offline" <%= filters.status === 'offline' ? 'selected' : '' %>>⚫ Offline</option>
                </select>
            </div>

            <div class="col-md-2">
                <button type="submit" class="btn btn-sign w-100">Filter</button>
            </div>
        </form>
    </div>

    <!--------------------------------------USERS-------------------------------------------->

    <div class="row">
        <% if (users.length > 0) { %>
            <% users.forEach(user => { %>
                <div class="col-md-6 mb-3">
                    <div class="card p-3 h-100 border-<%= user.isConnected ? 'success' : 'secondary' %>">
                        
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h4 class="m-0"><%= user.username %></h4>
                            <span>
                                <% if (user.status === 'online') { %> 🟢 Online
                                <% } else if (user.status === 'busy') { %> 🔴 Busy
                                <% } else { %> ⚫ Offline <% } %>
                            </span>
                        </div>

                        <% if (user.playingGame && user.playingWith) { %>
                            <div class="alert alert-warning py-1 px-2 mb-2" role="alert">
                                ⚔️ Playing currently <strong><%= user.playingGame %></strong> against <strong><%= user.playingWith %></strong>
                            </div>
                        <% } %>
                        
                        <!---------------------------LIST OF ACCEPTED GAMES-------------------------------------->
                        <hr>
                        <h5>Accepted Games :</h5>
                        <% if (user.acceptedGames.length > 0) { %>
                            <ul class="list-group list-group-flush overflow-scroll" style="max-height: 175px;">
                                <% user.acceptedGames.forEach(game => { %>
                                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                        <%= game.name %>
                                        <span class="badge bg-secondary rounded-pill">
                                            <%= game.won %> V / <%= game.played %> Played
                                        </span>
                                    </li>
                                <% }); %>
                            </ul>
                        <% } else { %>
                            <p class="text-muted">No games selected.</p>
                        <% } %>
                        
                        <!---------------------------LIST OF FAVORITES GAMES-------------------------------------->
                        <div class = "mt-3">
                            <h6>Favorite Games :</h6>
                            <% if (user.favorite_games.length > 0) { %>
                                <ul class="list-group list-group-flush overflow-scroll" style="max-height: 175px;">
                                    <% user.favorite_games.forEach(game => { %>
                                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                            <%= game %>
                                        </li>
                                    <% }); %>
                                </ul>
                            <% } else { %>
                                <p class="text-muted">No games selected.</p>
                            <% } %>
                        </div>

                <div class="mt-2">
                    <% if (typeof session_username !== 'undefined' && user.username !== session_username) { %>
                        <form action="/api/invite" method="POST" class="d-flex align-items-center gap-2">
                            <input type="hidden" name="receiver_username" value="<%= user.username %>">
                            
                            <select name="game_name" class="form-select form-select-sm w-auto">
                                <option value="Tic Tac Toe">Tic Tac Toe</option>
                                <option value="Power 4">Power 4</option>
                            </select>
                            
                            <% if (user.status === 'offline') { %>
                                <input type="datetime-local" name="proposed_date" class="form-control form-control-sm w-auto" required>
                                <button type="submit" class="btn btn-sm btn-outline-secondary">Propose (Email)</button>
                            <% } else { %>
                                <button type="submit" class="btn btn-sm btn-primary">Invite</button>
                            <% } %>
                        </form>
                    <% } %>
                </div>
                    </div>
                </div>
            <% }); %>
        <% } else { %>
            <div class="alert alert-info">No users match your filters.</div>
        <% } %>
    </div>
</div>

<%- include('../partials/footer.ejs') %>