<%- include('../partials/header.ejs', {
        title : "User Profile",
        is_connect : true,
        is_display_buttons : true,
        script : "/profile.js",
        
        stylesheet_html: 
        '<link rel="stylesheet" href="/css-styles/style.css">' +
        '<link rel="stylesheet" href="/css-styles/profile.css">'
    }) 
%>
    <h1 id = "title">User Profile</h1>

    <div id = "personal-info" class = "mb-4 p-2 border rounded">
        <h2>Personal Informations</h2>
        <p><strong>Username:</strong> <%= user.username %></p>
        <p><strong>Email:</strong> <%= user.email %></p>
        <p><strong>First Name:</strong> <%= user.firstname %></p>
        <p><strong>Last Name:</strong> <%= user.lastname %></p>
        <p><strong>Status:</strong> 
            <% if (user.status === 'online') { %>
                🟢 Online
            <% } else if (user.status === 'busy') { %>
                🔴 Busy
            <% } else { %>
                <%= user.status %>
            <% } %>
        </p>
    </div>
    <div class = "justify-content-center mx-auto text-center mb-3">
        <a class = "btn btn-sign m-2 w-50" href="/notifications">🔔 My invitations</a>
    </div>
    <div class = "justify-content-center mx-auto text-center mb-3">
        <a class = "btn btn-sign m-2 w-50" href="/profile/stats">See your stats</a>
    </div>

    <%- include('profile_forms.ejs') %>
    <div class = "mb-4 p-2 border rounded">
        <h2>Games that I want to play :</h2>

        <div id = "game-list-wrapper" class = "container-fluid py-2">
            <ul id = "game-list" class = "overflow-auto list-unstyled">
                <% if (games && games.length > 0) { %>

                    <% games.forEach(game => { %>
                        <li class = "game-item my-1 px-4 py-2 border rounded">
                            <div class = "mb-3">
                                <strong><%= game.name %></strong>
                            </div>
                            <img src="<%= game.image %>" alt="<%= game.name %>" class = "img-fluid"><br>
                            <p><%= game.description || "Pas de description" %></p>
                        </li>
                    <% }); %>

                <% } else { %>
                    <span>No game selected.</span>
                <% } %>
            </ul>
        </div>
        
    </div>

    <a href="/" class = "btn btn-sign m-2">Back to home</a>

<%- include('../partials/footer.ejs') %>