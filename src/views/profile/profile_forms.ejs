<div class = "row">

    <!-------------------UPDATE STATUS FORM------------------------->
    <% 
    function form_div_class() {
        return "col-md-6 mb-4 p-3 border rounded";
    }
    %>

    <div class="<%= form_div_class() %>">
        <h2>Update Status</h2>
        <form action="/profile" method="POST">
            <input type="hidden" name="formType" value="updateStatus">
            
            <div class="mb-3">
                <label for="statusSelect" class="form-label bold">Choose your status:</label>
                <select name="status" id="statusSelect" class="form-select">
                    <option value="online" <%= user.status === 'online' ? 'selected' : '' %>>🟢 Online</option>
                    <option value="busy" <%= user.status === 'busy' ? 'selected' : '' %>>🔴 Busy</option>
                    <option value="offline" <%= user.status === 'offline' ? 'selected' : '' %>>⚫ Offline</option>
                </select>
            </div>
            
            <button type="submit" class="btn btn-sign">Update Status</button>
        </form>
    </div>

    <!-------------------UPDATE PASSWORD FORM------------------------->

    <div class="<%= form_div_class() %>">
        <h2>Update Password</h2>
        <form action="/profile" method="POST">
            <input type="hidden" name="formType" value="updatePassword">
            
            <div class="mb-2">
                <label class="form-label bold">Current Password:</label>
                <input type="password" name="currentPassword" class="form-control" required>
            </div>
            <div class="mb-2">
                <label class="form-label bold">New Password:</label>
                <input type="password" name="newPassword" class="form-control" required>
            </div>
            <div class="mb-2">
                <label class="form-label bold">Confirm New Password:</label>
                <input type="password" name="confirmPassword" class="form-control" required>
            </div>
            <button type="submit" class="btn btn-sign mt-3">Update Password</button>
        </form>
    </div>
</div>

<!---------------------MANAGE FAV GAMES----------------------------->

<div class="mb-4 p-3 border rounded">
<h2>Manage My Games</h2>
<form action="/profile" method="POST">
    <input type="hidden" name="formType" value="updateGames">
    
    <div class="mb-3">
        <p><strong>Choose games you want to play:</strong></p>
        <% allGames.forEach(game => { %>
            <% const isChecked = games.some(g => g.id === game.id) ? 'checked' : ''; %>
            
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="checkbox" name="selectedGames" value="<%= game.id %>" id="<%= game.id %>" <%= isChecked %>>
                <label class="form-check-label" for="<%= game.id %>"><%= game.name %></label>
            </div>
        <% }); %>
    </div>
    <button type="submit" class="btn btn-sign">Save My Games</button>
</form>
</div>