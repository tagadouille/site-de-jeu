<%- include('partials/header.ejs', {
        title : "Home Page",
        script : "/index.js",
        stylesheet_html: '<link rel="stylesheet" href="/index.css">'
    }) %>

    <h1 id = "title">List of the games : </h1>

    <article class = "games-list row justify-content-center">
        
        <!----------------- GAMES DISPLAY -------------------------->
        <% games.forEach(game => { %>
            <div class="col-lg-3 col-md-4 col-sm-6">

                <div class = "game-wrapper p-0 m-2">
                    <a href="/game/<%= game.name %>" class = "p-0">
                        <div class = "game">
                            <h2 class = "game-name"><%= game.name %></h2>
                            <img src="<%= game.image %>" alt="<%= game.name %> image" class = "game-image img-thumbnail">
                            <p><%= game.description%></p>
                        </div>
                    </a>
                </div>

            </div>
        <% }) %>
    </article>
    
<%- include('partials/footer.ejs') %>