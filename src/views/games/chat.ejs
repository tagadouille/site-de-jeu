<script defer src="/games/chat.js"></script>
<link rel="stylesheet" href="/css-styles/chat.css">

<!-----------MESSAGE CONTAINER------------->
<div class="message-container">

    <div class="message rounded user1">
        <label><strong>Pseudo 1</strong></label>
        <p>Bonjour es-tu prêt ?</p>
    </div>
    <div class="message rounded user2">
        <label><strong>Pseudo 2</strong></label>
        <p>Oui commençons !</p>
    </div>
</div>
<div class="message-bar">

    <input type="text" value="" name="message" id="message-write" class="rounded">
    <input type="button" value="📨" name="send" id="send" class="btn btn-sign">
</div>

<!-----------CHAT METADATA------------->
<div class="chat-data" 
    data-sender-id="<%= user_id %>"
    data-receiver-id="<%= receiver_id %>"
    data-conversation-id="<%= match_id %>"
>
</div>