<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <script src="/jquery-4.0.0.min.js"></script>
    <script defer type="module" src="<%= script %>"></script>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">

    <link rel = "stylesheet" href = "/css-styles/header.css">
    <link rel = "stylesheet" href = "/css-styles/footer.css">
    <%- stylesheet_html %>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">

    <title>
        <%= title%>
    </title>
</head>

<body class="container-fluid px-0">

    <!----------- -----------HEADER ---------------------------->
    <header id="header">

        <nav class="navbar navbar-expand-md navbar-dark px-3">

            <!-- LOGO -->
            <a class="navbar-brand" href="/">
                <img src="/favicon.ico" alt="Logo">
                Site Name
            </a>

            <!-- TOGGLER -->
            <button class="navbar-toggler ms-auto" type="button" data-bs-toggle="collapse"
                data-bs-target="#navbarContent" id="toggler">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- COLLAPSE -->
            <div class="collapse navbar-collapse" id="navbarContent">
                <div class="d-flex w-100 align-items-center">

                    <!-- SEARCH -->
                    <div class="mx-auto w-25 d-none d-md-block">
                        <% search_bar() %>
                    </div>

                    <!-- BUTTONS -->
                    <div class="navbar-nav ms-auto d-none d-md-flex">
                        <% nav_buttons() %>
                    </div>

                </div>

                <!-- MOBILE VIEW -->
                <div class="d-block d-md-none w-100 mt-2">
                    <!-- SEARCH MOBILE -->
                    <div class="mb-2">
                        <% search_bar() %>
                    </div>

                    <!-- BUTTONS MOBILE (centered) -->
                    <div class="navbar-nav d-flex justify-content-center">
                        <% nav_buttons() %>
                    </div>
                </div>
            </div>

            <!-----------FACTORISATION FUNCTIONS-------------->
            <% 
                function nav_buttons() {

                    if(is_display_buttons) {

                        let button_class = "nav-link btn btn-sign mx-1 my-1";

                        if(is_connect) { %>
                                <a href="/profile" class= "<%= button_class%>" >Profile</a>
                                <a href="/logout" class= "<%= button_class%>">Log out</a>
                            <% } else { %>
                                <a href="/signin" class= "<%= button_class%>">Sign in</a>
                                <a href="/signup" class= "<%= button_class%>">Sign up</a>
                        <% }
                    }
                } 
                
                function search_bar() { %>
                     <input type="text" class="form-control" placeholder="Search..." name="search">
                    <%
                }
            %>

        </nav>
    </header>